# =========================================================
# DEVLOG PRO - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# =========================================================

# KIMI_API_KEY / MOONSHOT_API_KEY: Clave de API para Kimi K3 / Moonshot AI
# Configúrala en Google AI Studio en el panel de Secrets (Ajustes -> Secrets)
# o ingresa tu clave aquí para desarrollo local.
KIMI_API_KEY=
MOONSHOT_API_KEY=

# GEMINI_API_KEY: Clave de API de Google Gemini (suministrada automáticamente en AI Studio)
GEMINI_API_KEY=

# SUPABASE SERVER CONFIGURATION (Base de datos PostgreSQL en la nube)
# Obtén estos valores en tu panel de Supabase: Project Settings -> API
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=

# GOOGLE SHEETS SERVICE ACCOUNT INTEGRATION
# Pega aquí o en Secrets el JSON completo de tu Cuenta de Servicio de Google Cloud
# (con client_email, private_key, project_id, etc.)
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
# ID de la hoja de cálculo de Google Sheets (opcional, o configurable en la app)
GOOGLE_SHEETS_SPREADSHEET_ID=

# APP_URL: URL base de la aplicación (inyectada automáticamente por AI Studio en Cloud Run)
APP_URL=
